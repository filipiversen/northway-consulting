# Copy to .env (or .env.local) for local dev, and set the same in
# Vercel → Project → Settings → Environment Variables for production.

# ----- Retainer checkout (Stripe) — powers /start -----

# Required: API keys from https://dashboard.stripe.com/apikeys
# (sandbox/test keys locally, live keys in production).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Required for /api/stripe/webhook: the endpoint's signing secret.
# Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints one. In production, create the endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: billing-portal configuration (pause/cancel rules) for the
# "Manage billing" button after checkout.
STRIPE_PORTAL_CONFIG_ID=bpc_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: pin the exact price (or product) to sell. If neither is set,
# checkout uses the account's single active recurring price and refuses to
# guess when there's more than one.
# STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_PRODUCT_ID=prod_xxxxxxxxxxxxxxxxxxxxxxxx

# ----- Contact form (Resend) -----

# Required: your Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: inbox that receives contact submissions.
# Defaults to the address in src/content/profile.ts if unset.
CONTACT_TO_EMAIL=you@example.com

# Optional: the "from" sender. Must be on a domain you've verified in Resend.
# Until you verify northway.consulting, Resend's onboarding@resend.dev works for
# testing but only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=Northway Consulting <onboarding@resend.dev>
